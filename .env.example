# LIFEOS Environment Configuration

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=True
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Security & Authentication
JWT_SECRET=super-secret-lifeos-key-change-this-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (MongoDB)
# Provide MongoDB Atlas or local connection string:
# MONGODB_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
# MONGODB_URL=mongodb://localhost:27017
MONGODB_URL=
DATABASE_NAME=lifeos_db

# AI Service Configuration
# Supported providers: gemini, openai, deterministic
AI_PROVIDER=deterministic
# Set your API key if using gemini or openai:
GEMINI_API_KEY=
OPENAI_API_KEY=
